# 服务端口
PORT=3000
NODE_ENV=development
API_VERSION=v1
LOG_LEVEL=debug

# 数据库
DATABASE_URL=postgresql://haycargo:haycargo@localhost:5432/haycargo

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-me-in-production-use-a-real-secret-key
JWT_EXPIRES_IN=7d

# 对象存储 (MinIO / S3 兼容)
OSS_ENDPOINT=http://localhost:9000
OSS_REGION=us-east-1
OSS_ACCESS_KEY=haycargo
OSS_SECRET_KEY=haycargo
OSS_BUCKET=haycargo-files
OSS_FORCE_PATH_STYLE=true

# CORS
CORS_ORIGIN=http://localhost:5173

# 租户隔离
TENANT_HEADER=x-tenant-id
SUPER_ADMIN_BYPASS_TENANT=true