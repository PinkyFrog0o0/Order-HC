# Haycargo 生产环境变量样例
# 复制此文件为 .env.prod 并填入真实值
# .env.prod 已在 .gitignore 中，不会被提交
# 启动：docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build

# === JWT ===
# ⚠️ 生产环境必须换成强随机字符串（建议 64 字符以上）
# 生成方式：openssl rand -hex 32
JWT_SECRET=change-me-please-use-openssl-rand-hex-32
JWT_EXPIRES_IN=7d

# === MinIO / OSS 凭据 ===
OSS_REGION=us-east-1
OSS_ACCESS_KEY=haycargo
OSS_SECRET_KEY=haycargo
OSS_BUCKET=haycargo-files

# === Web 访问地址（CORS 白名单） ===
# 多地址用英文逗号分隔
# 例如：http://example.com,http://47.99.176.89:7700
CORS_ORIGIN=http://47.99.176.89:7700

# === 检查更新（GitHub Releases） ===
# 格式：owner/repo
GITHUB_REPO=PinkyFrog0o0/Order-HC
# GitHub PAT（可访问该 repo 即可）
GITHUB_TOKEN=
